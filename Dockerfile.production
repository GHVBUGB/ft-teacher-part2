FROM node:22-bookworm-slim AS frontend
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN corepack pnpm install --frozen-lockfile
COPY src ./src
COPY public ./public
COPY index.html vite.config.ts tsconfig.json ./
RUN FT_FRONTEND_MODE=live corepack pnpm run build

FROM python:3.12-slim
WORKDIR /app
COPY server/production/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY server/production ./production
COPY server/practice ./practice
COPY --from=frontend /app/dist-production /app/static
RUN useradd --uid 10001 --create-home appuser
USER 10001
ENV FT_STATIC_DIRECTORY=/app/static
ENV PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn production.web:app --host 0.0.0.0 --port ${PORT}"]
